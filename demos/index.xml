 color: rgba(255,255,255,0.4);
}
.de-attach-link {
 color: var(--haltian-radiant-green);
 text-decoration: none;
 font-size: 0.85rem;
 font-weight: 600;
 white-space: nowrap;
}
.de-attach-link:hover {
 text-decoration: underline;
}

/* ── Spinner ── */
.de-spinner {
 display: inline-block;
 width: 18px;
 height: 18px;
 border: 2px solid rgba(115, 249, 193, 0.3);
 border-top-color: var(--haltian-radiant-green);
 border-radius: 50%;
 animation: de-spin 0.7s linear infinite;
 vertical-align: middle;
 margin-right: 6px;
}
@keyframes de-spin {
 to { transform: rotate(360deg); }
}
.de-empty {
 text-align: center;
 color: rgba(255,255,255,0.4);
 padding: 20px;
 font-size: 0.9rem;
}

/* ── Location map placeholder ── */
.de-location-info {
