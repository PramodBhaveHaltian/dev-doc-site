 grid-template-columns: 1fr 1fr;
 gap: 10px;
}
@media (max-width: 600px) {
 .de-meas-grid { grid-template-columns: 1fr; }
}
.de-meas-card {
 background: rgba(0,0,0,0.2);
 border-radius: 6px;
 padding: 12px 14px;
}
.de-meas-card .de-meas-type {
 font-size: 0.75rem;
 color: rgba(255,255,255,0.5);
 text-transform: uppercase;
 letter-spacing: 0.3px;
 margin-bottom: 4px;
}
.de-meas-card .de-meas-value {
 font-size: 1.1rem;
 font-weight: 600;
 color: var(--haltian-radiant-green);
}
.de-meas-card .de-meas-time {
 font-size: 0.7rem;
 color: rgba(255,255,255,0.35);
 margin-top: 2px;
}
.de-meas-card.loading .de-meas-value {
